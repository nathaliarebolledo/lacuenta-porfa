{
  "expo": {
    "name": "La cuenta, porfa",
    "slug": "lacuenta-porfa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lacuentaporfa",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lacuentaporfa.app"
    },
    "android": {
      "package": "com.lacuentaporfa.app",
      "adaptiveIcon": {
        "backgroundColor": "#F9FAFB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "La cuenta, porfa",
      "shortName": "La cuenta, porfa",
      "themeColor": "#3B82F6",
      "backgroundColor": "#F9FAFB",
      "display": "standalone",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F9FAFB",
          "dark": {
            "backgroundColor": "#101317"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
